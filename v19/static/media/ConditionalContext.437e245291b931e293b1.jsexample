const ThemeContext = React.createContext('light');

function ThemedButton(props) {
  const {showButton} = props;

  // use() can be called conditionally, unlike other Hooks -
  // useContext could not be called after an early return like this.
  if (!showButton) {
    return <div>Button is hidden</div>;
  }

  const theme = React.use(ThemeContext);

  return (
    <button className={theme}>Themed Button (theme: {theme})</button>
  );
}

const initial = {
  showButton: true,
};

render(
  <ThemeContext.Provider value='dark'>
    <PropOverride initial={initial}>
      <ThemedButton />
    </PropOverride>
  </ThemeContext.Provider>
);
